{
  "name": "nexora-web-fullstack",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers + D1 premium full-stack multi-page business website for Nexora Web.",
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:apply": "wrangler d1 migrations apply nexora-web-db --remote",
    "d1:apply:local": "wrangler d1 migrations apply nexora-web-db --local",
    "check": "node --check worker.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}